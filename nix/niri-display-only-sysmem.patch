+    /// Checks whether the primary GPU can render into buffers allocated on a display-only device.
+    fn primary_can_render_into(&mut self, gbm: &GbmDevice<DrmDeviceFd>) -> bool {
+        if std::env::var_os("NIRI_DISPLAY_ONLY_PRIMARY_ALLOC").is_some() {
+            debug!("NIRI_DISPLAY_ONLY_PRIMARY_ALLOC set, allocating on the primary GPU");
+            return false;
+        }
+
+        let mut allocator =
+            GbmAllocator::new(gbm.clone(), GbmBufferFlags::RENDERING | GbmBufferFlags::SCANOUT);
+        let buffer = match allocator.create_buffer(64, 64, Fourcc::Xrgb8888, &[Modifier::Linear]) {
+            Ok(buffer) => buffer,
+            Err(err) => {
+                debug!("display-only device can't allocate buffers: {err:?}");
+                return false;
+            }
+        };
+        let mut dmabuf = match buffer.export() {
+            Ok(dmabuf) => dmabuf,
+            Err(err) => {
+                debug!("display-only device can't export buffers: {err:?}");
+                return false;
+            }
+        };
+        let mut renderer = match self.gpu_manager.single_renderer(&self.primary_render_node) {
+            Ok(renderer) => renderer,
+            Err(err) => {
+                debug!("no primary renderer to test display-only buffers with: {err:?}");
+                return false;
+            }
+        };
+        let res = renderer.as_gles_renderer().bind(&mut dmabuf).map(drop);
+        match res {
+            Ok(()) => true,
+            Err(err) => {
+                debug!("primary GPU can't render into display-only device buffers: {err:?}");
+                false
+            }
+        }
+    }
