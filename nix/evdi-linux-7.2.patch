diff --git a/module/evdi_fb.c b/module/evdi_fb.c
index a6a2edc..eff3f3a 100644
--- a/module/evdi_fb.c
+++ b/module/evdi_fb.c
@@ -102,7 +102,7 @@ static int evdi_user_framebuffer_dirty(
 	struct evdi_device *evdi = dev->dev_private;
 
 	struct drm_modeset_acquire_ctx ctx;
-	struct drm_atomic_state *state;
+	struct drm_atomic_commit *state;
 	struct drm_plane *plane;
 	int ret = 0;
 	unsigned int i;
@@ -116,7 +116,7 @@ static int evdi_user_framebuffer_dirty(
 		 */
 		file_priv ? DRM_MODESET_ACQUIRE_INTERRUPTIBLE :	0);
 
-	state = drm_atomic_state_alloc(fb->dev);
+	state = drm_atomic_commit_alloc(fb->dev);
 	if (!state) {
 		ret = -ENOMEM;
 		goto out;
@@ -150,14 +150,14 @@ retry:
 
 out:
 	if (ret == -EDEADLK) {
-		drm_atomic_state_clear(state);
+		drm_atomic_commit_clear(state);
 		ret = drm_modeset_backoff(&ctx);
 		if (!ret)
 			goto retry;
 	}
 
 	if (state)
-		drm_atomic_state_put(state);
+		drm_atomic_commit_put(state);
 
 	drm_modeset_drop_locks(&ctx);
 	drm_modeset_acquire_fini(&ctx);
