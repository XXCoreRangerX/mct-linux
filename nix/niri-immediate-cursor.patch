+    /// Moves the hardware cursor on `output` right away, without waiting for the next frame.
+    ///
+    /// A frame commit carries the cursor position, and only one frame can be in flight, so
+    /// with frames alone a pointer move waits for the frame in flight to be shown first:
+    /// up to a refresh interval. Smithay can move the cursor plane in between with the
+    /// legacy cursor ioctl, which drivers with asynchronous cursor updates apply at once.
+    /// Only a pure move of an unchanged cursor on the cursor plane is done here; the
+    /// redraw queued by the caller still renders the frame as usual.
+    pub fn move_cursor_immediately(&mut self, niri: &mut Niri, output: &Output) {
+        let _span = tracy_client::span!("Tty::move_cursor_immediately");
+
+        if !niri.pointer_visibility.is_visible() {
+            return;
+        }
+        // With VRR, cursor moves are kept off the frame timing on purpose.
+        if niri
+            .output_state
+            .get(output)
+            .is_none_or(|state| state.frame_clock.vrr())
+        {
+            return;
+        }
+
+        let Some(tty_state) = output.user_data().get::<TtyOutputState>() else {
+            return;
+        };
+        let Some(device) = self.devices.get_mut(&tty_state.node) else {
+            return;
+        };
+        if !device.drm.is_active() {
+            return;
+        }
+        let Some(surface) = device.surfaces.get_mut(&tty_state.crtc) else {
+            return;
+        };
+        if !surface.compositor.immediate_cursor_available() {
+            return;
+        }
+
+        let mut renderer = match self.gpu_manager.renderer(
+            &self.primary_render_node,
+            &device.render_node.unwrap_or(self.primary_render_node),
+            surface.compositor.format(),
+        ) {
+            Ok(renderer) => renderer,
+            Err(_) => return,
+        };
+
+        // The same elements as the frame renders for the pointer. Only a single one (no
+        // drag-and-drop icon, no cursor subsurfaces) can be the cursor plane alone.
+        let mut elements = Vec::new();
+        niri.render_pointer(&mut renderer, output, &mut |elem| elements.push(elem));
+        let [element] = elements.as_slice() else {
+            return;
+        };
+
+        if let Err(err) = surface.compositor.move_cursor_immediately(element) {
+            debug!("error moving the cursor immediately: {err:?}");
+        }
+    }
+
