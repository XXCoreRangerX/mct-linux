+    /// Moves the hardware cursor right away on the output under it, ahead of the redraw.
+    ///
+    /// Off with `NIRI_IMMEDIATE_CURSOR=0`.
+    fn move_cursor_immediately(&mut self) {
+        static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        if !*ENABLED.get_or_init(|| {
+            std::env::var_os("NIRI_IMMEDIATE_CURSOR").is_none_or(|value| value != "0")
+        }) {
+            return;
+        }
+
+        let pos = self
+            .niri
+            .tablet_cursor_location
+            .unwrap_or_else(|| self.niri.seat.get_pointer().unwrap().current_location());
+        let Some((output, _)) = self.niri.output_under(pos) else {
+            return;
+        };
+        let output = output.clone();
+        self.backend.move_cursor_immediately(&mut self.niri, &output);
+    }
